{
    "name": "ttek/tk8base",
    "type": "project",
    "description": "A base example site using the tropotek tk v8 libs.",
    "keywords": [
        "tropotek"
    ],
    "time": "2022-10-17",
    "license": "MIT",
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "Tropotek",
            "homepage": "http://www.tropotek.com/"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "htmx/htmx",
                "version": "2.0.4",
                "dist": {
                    "url": "https://unpkg.com/htmx.org/dist/htmx.min.js",
                    "type": "file"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "jquery/jquery",
                "version": "3.7.1",
                "dist": {
                    "url": "https://code.jquery.com/jquery-3.7.1.min.js",
                    "type": "file"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Bs\\Composer\\Installer::postInstall"
        ],
        "post-update-cmd": [
            "Bs\\Composer\\Installer::postUpdate"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-libxml": "*",
        "ext-dom": "*",
        "ext-tidy": "*",
        "ext-openssl": "*",

        "ttek/tk-base": "~8.0.0",
        "htmx/htmx": "2.0.4",
        "jquery/jquery": "3.7.1",
        "twbs/bootstrap": "~5.3.0-@stable",
        "select2/select2": "~4.0-@stable",
        "studio-42/elfinder": "~2.1.0-@stable"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "config": {
        "preferred-install": {
            "ttek/*": "source"
        },
        "component-dir": "vendor/components"
    }
}
