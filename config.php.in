<?php
/**
 * Site Config
 * Copy this to config.php and edit with your server settings
 */
use Tk\Config;

defined('TKAPP') || die();

return function (Config $config) {

    /**
     * System DB DSN: hostname[:port]/username/password/dbname
     */
    $config['db.mysql'] = '{db.mysql}';

    /**
     * Enable error email notifications
     */
    //$config['system.email.exception'] = ['user@example.net'];

    /*
     * Send copies of all system emails to these recipients (not error emails)
     */
    //$config['mail.bcc'] = ['user@example.org'];

    /**
     * System string encrypt secret
     * Do not change this after site install
     */
    $config['system.encrypt'] = '{system.encrypt}';

    /**
     * Set the site timezone for PHP and MySQL
     */
    $config['php.date.timezone'] = 'Australia/Melbourne';



    // site environment type
    $config['env.type'] = Config::ENV_DEVELOPMENT;

    // Setup dev environment
    if ($config->isDev()) {
        // Send all emails to the debug address
        $config['system.debug.email'] = 'user@example.net';

        // DB mirror src site (site root path)
        $config['db.mirror.secret'] = 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx';
        $config['db.mirror.url'] = 'https://localhost/';

        $config['auth.password.strict'] = false;

        error_reporting(-1);
        $config['php.display_errors'] = 'On';
        $config['php.error_log'] = '/var/logs/error.log';
        $config['log.logLevel'] = \Psr\Log\LogLevel::DEBUG;
        //$config['log.logLevel'] = \Psr\Log\LogLevel::WARNING;

        // force logging with NO_LOG links
        //$config['log.enableNoLog'] = false;

        // customise request log info
        $config['site.log.params'] = 0
            // | StartupHandler::SITE_NAME
            // | StartupHandler::REQUEST_URI
            // | StartupHandler::CLIENT_IP
            // | StartupHandler::CLIENT_AGENT
            // | StartupHandler::SESSION_ID
            // | StartupHandler::PHP_VER
            // | StartupHandler::CONTROLLER
            // | StartupHandler::METRICS
        ;
    }
};
